{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@fairway-kit/client/react/markdown": ["../../../js/packages/client/src/react/markdown.tsx"],
      "@fairway-kit/client/react": ["../../../js/packages/client/src/react/index.ts"],
      "@fairway-kit/client": ["../../../js/packages/client/src/index.ts"],
      "@fairway-kit/protocol": ["../../../js/packages/protocol/src/index.ts"]
    }
  },
  "include": ["src"]
}
