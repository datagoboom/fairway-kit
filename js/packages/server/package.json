{
  "name": "@fairway-kit/server",
  "version": "0.1.0",
  "description": "Dev kit backend for local agent-backed apps: durable, resumable agent chat over Node (SQLite), implementing the Agent Chat Protocol",
  "license": "MIT",
  "author": "Andrew Long",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datagoboom/fairway-kit.git",
    "directory": "js/packages/server"
  },
  "homepage": "https://github.com/datagoboom/fairway-kit",
  "keywords": [
    "agent",
    "chat",
    "sse",
    "streaming",
    "node",
    "server",
    "local-first"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./claude": {
      "types": "./dist/adapters/claude.d.ts",
      "default": "./dist/adapters/claude.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "*",
    "mysql2": "*",
    "pg": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fairway-kit/protocol": "0.4.2",
    "better-sqlite3": "^11.0.0",
    "busboy": "^1.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.21.0",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
