{
  "name": "@fairway-kit/agent",
  "version": "0.1.0",
  "description": "Agent integration toolkit for fairway: the Runner contract, a normalized event pump, and adapters (Claude, ...) that turn any agent into durable protocol events",
  "license": "MIT",
  "author": "Andrew Long",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datagoboom/fairway-kit.git",
    "directory": "js/packages/agent"
  },
  "homepage": "https://github.com/datagoboom/fairway-kit",
  "keywords": [
    "agent",
    "llm",
    "runner",
    "adapter",
    "streaming",
    "tool-use",
    "local-first"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./claude-code": {
      "types": "./dist/adapters/claude-code.d.ts",
      "default": "./dist/adapters/claude-code.js"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": { "optional": true }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:claude": "tsx scripts/smoke-claude.ts"
  },
  "dependencies": {
    "@fairway-kit/protocol": "0.4.2"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.227",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
