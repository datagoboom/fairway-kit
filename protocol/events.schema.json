{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairway.dev/protocol/events.schema.json",
  "title": "Agent Chat Protocol event (v0.1)",
  "description": "Envelope + core event union. Types beginning x_ are extensions and validate against the envelope only. See PROTOCOL.md sections 2-3.",
  "type": "object",
  "required": ["seq", "type", "ts"],
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "type": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "message_start" } } },
      "then": { "required": ["message_id"], "properties": { "message_id": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["text", "text_block", "thinking"] } } },
      "then": { "required": ["content"], "properties": { "content": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "tool_call" } } },
      "then": {
        "required": ["id", "tool", "kind", "label"],
        "properties": {
          "id": { "type": "string" },
          "tool": { "type": "string" },
          "kind": { "type": "string" },
          "label": { "type": "string" },
          "detail": { "type": "string" },
          "input": { "type": "object" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "tool_result" } } },
      "then": {
        "required": ["id", "ok"],
        "properties": {
          "id": { "type": "string" },
          "ok": { "type": "boolean" },
          "summary": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "permission_request" } } },
      "then": {
        "required": ["id", "tool", "kind", "label"],
        "properties": {
          "id": { "type": "string" },
          "tool": { "type": "string" },
          "kind": { "type": "string" },
          "label": { "type": "string" },
          "detail": { "type": "string" },
          "input": { "type": "object" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "permission_resolved" } } },
      "then": {
        "required": ["id", "decision"],
        "properties": {
          "id": { "type": "string" },
          "decision": { "enum": ["allow", "allow_session", "deny"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "done" } } },
      "then": { "required": ["message_id"], "properties": { "message_id": { "type": "string" }, "reason": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "error" } } },
      "then": { "required": ["message"], "properties": { "message": { "type": "string" }, "message_id": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "cancelled" } } },
      "then": { "properties": { "message_id": { "type": "string" } } }
    },
    {
      "if": {
        "properties": {
          "type": {
            "not": {
              "anyOf": [
                { "enum": ["message_start", "text", "text_block", "thinking", "tool_call", "tool_result", "permission_request", "permission_resolved", "done", "error", "cancelled"] },
                { "pattern": "^x_" }
              ]
            }
          }
        }
      },
      "then": {
        "$comment": "Unknown non-extension types are still valid envelopes; consumers treat them as opaque (PROTOCOL.md section 2)."
      }
    }
  ]
}
